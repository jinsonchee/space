# ---- Required ----
# Your own Postgres database (Supabase → Connect → "Transaction pooler" URI)
DATABASE_URL=
# Any long random string (keeps logins secure). Generate one at https://1password.com/password-generator
SESSION_SECRET=
# A one-time code you make up — you'll type it on the first setup screen
SETUP_CODE=
# Any long random string — protects the scheduled reminders
CRON_SECRET=
# Your Space's web address, e.g. https://layyi-space.vercel.app (used in email links)
APP_URL=

# ---- Optional: email reminders (free tier at resend.com) ----
RESEND_API_KEY=
EMAIL_FROM=Space <hello@yourdomain.com>

# ---- Optional: Google Calendar (read-only) + Gmail (read + send) ----
# From your own Google Cloud project → Google Auth Platform → Clients (Web application).
# Redirect URI to register there: <APP_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Set by the publisher — leave as is ----
UPDATE_FEED_URL=https://raw.githubusercontent.com/jinsonchee/space/main/version.json
