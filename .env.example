# ---- Required ----
# Your own Postgres database (Supabase → Connect → "Transaction pooler" URI)
DATABASE_URL=
# Any long random string (keeps logins secure). Generate one at https://1password.com/password-generator
SESSION_SECRET=
# A one-time code you make up — you'll type it on the first setup screen
SETUP_CODE=
# Any long random string — protects the scheduled reminders
CRON_SECRET=
# Your Space's web address, e.g. https://layyi-space.vercel.app (used in email links)
APP_URL=

# ---- Optional: email reminders (free tier at resend.com) ----
RESEND_API_KEY=
EMAIL_FROM=Space <hello@yourdomain.com>

# ---- Optional: Google Calendar (read-only) + Gmail (read + send) ----
# From your own Google Cloud project → Google Auth Platform → Clients (Web application).
# Redirect URI to register there: <APP_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Optional: YouTube stats (public channel numbers, updated daily) ----
# API key from your own Google Cloud project (APIs & Services → Credentials), restricted to "YouTube Data API v3".
YOUTUBE_API_KEY=

# ---- Optional: Instagram stats (set by the publisher — the publisher's Meta app "SPACE-IG") ----
# The artist's Instagram must be a Creator/Business account added as an "Instagram tester" on that app.
# Register <APP_URL>/api/instagram/callback under the app's Instagram business login redirect URIs.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ---- Optional: TikTok stats (set by the publisher — the publisher's TikTok app "SPACE", Sandbox) ----
# The artist's TikTok must be a Sandbox "target user" on that app (max 10). Register
# <APP_URL>/api/tiktok/callback as a Login Kit Web redirect URI.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---- Set by the publisher — leave as is ----
UPDATE_FEED_URL=https://raw.githubusercontent.com/jinsonchee/space/main/version.json
